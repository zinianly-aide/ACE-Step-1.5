# ACE-Step 1.5 — Apple Silicon performance profile
# Copy to `.env` and edit locally. `.env` is gitignored.
#
# Tuned default target: Mac mini M4 / 16GB unified memory.

# --- Model / backend ---
ACESTEP_CONFIG_PATH=acestep-v15-turbo
ACESTEP_LM_BACKEND=mlx
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-0.6B
ACESTEP_INIT_LLM=auto

# Keep only one DiT resident on 16GB machines.
ACESTEP_USE_MLX_DIT=false
ACESTEP_OFFLOAD_TO_CPU=false
ACESTEP_OFFLOAD_DIT_TO_CPU=false
ACESTEP_LM_OFFLOAD_TO_CPU=false
ACESTEP_COMPILE_MODEL=false

# Long-audio decode: PyTorch/MPS tiled VAE is currently the safer path.
ACESTEP_MLX_VAE=0
ACESTEP_MLX_VAE_CHUNK=192

# Keep one generation worker. Submit seeds serially instead of parallel jobs.
ACESTEP_QUEUE_WORKERS=1
ACESTEP_QUEUE_MAXSIZE=32

# Eager load once when starting the API server so batch generation avoids
# paying model-load latency on the first real job.
ACESTEP_NO_INIT=false

# --- API ---
ACESTEP_API_HOST=127.0.0.1
ACESTEP_API_PORT=8001
ACESTEP_DOWNLOAD_SOURCE=modelscope

# --- Cache placement ---
# Default launcher cache root is ~/Library/Caches/ace-step.
# For a fast Thunderbolt/NVMe SSD, uncomment and change this path:
# ACESTEP_CACHE_ROOT=/Volumes/ssd/ace-step

# Optional advanced fallback. Enabling this may make unsupported MPS ops work,
# but CPU fallback can be much slower, so leave it off unless required.
# PYTORCH_ENABLE_MPS_FALLBACK=1
